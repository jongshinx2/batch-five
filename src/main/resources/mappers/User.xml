<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.springbatchdownversion.infrastructure.mappers.UserMapper">

    <select id="findAll" resultType="com.example.springbatchdownversion.domain.User" fetchSize="100">
        SELECT ROW_NUMBER() OVER(ORDER BY id) AS id
             , name
        FROM Users
    </select>

</mapper>